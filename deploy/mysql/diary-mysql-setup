#!/usr/bin/env bash
# HeatWave에 앱 DB(mydb)와 앱 전용 계정(diary_app)을 만든다. 여러 번 실행해도 안전하다.
#
# usage: diary-mysql-setup <DB 사설 IP>
# 필요: ~/.config/heatwave-admin.env (MYSQL_ADMIN_USERNAME 또는 MYSQL_ADMIN_USER, MYSQL_ADMIN_PASSWORD)
# 결과: ~/.config/diary-app-db.env (600). 비밀번호는 출력하지 않는다.
#   앱 계정은 mydb 하나에만 권한이 있고 TLS가 필수다. Flyway가 테이블을 만들므로 mydb에는 DDL 권한을 준다.

set -euo pipefail

readonly MYSQL_IMAGE="docker.io/library/mysql:8.4"
readonly APP_ENV="$HOME/.config/diary-app-db.env"
readonly DB_NAME="mydb"
readonly APP_USER="diary_app"
host="${1:?DB 사설 IP를 지정할 것}"

admin_value() { awk -F= -v k="$1" '$1 == k {print substr($0, index($0, "=") + 1); exit}' "$HOME/.config/heatwave-admin.env"; }
admin_user="$(admin_value MYSQL_ADMIN_USERNAME)"
[[ -n "$admin_user" ]] || admin_user="$(admin_value MYSQL_ADMIN_USER)"
admin_password="$(admin_value MYSQL_ADMIN_PASSWORD)"
[[ -n "$admin_user" && -n "$admin_password" ]] || { echo "heatwave-admin.env에 사용자 이름과 비밀번호가 필요하다" >&2; exit 1; }

# HeatWave 비밀번호 정책은 대소문자, 숫자, 특수문자를 모두 요구한다. 셸 source와 SQL 문자열에서 안전한 특수문자(-_.@)만 쓴다
new_password() {
  python3 - <<'PY'
import secrets, string
chars = string.ascii_letters + string.digits + "-_.@"
while True:
    p = "".join(secrets.choice(chars) for _ in range(40))
    if any(c.islower() for c in p) and any(c.isupper() for c in p) and any(c.isdigit() for c in p) and any(c in "-_.@" for c in p):
        print(p)
        break
PY
}

umask 077
if [[ ! -s "$APP_ENV" ]]; then
  printf 'APP_DB_HOST=%s\nAPP_DB_NAME=%s\nAPP_DB_USER=%s\nAPP_DB_PASSWORD=%s\n' \
    "$host" "$DB_NAME" "$APP_USER" "$(new_password)" >"$APP_ENV"
fi
# shellcheck source=/dev/null
source "$APP_ENV"

# 비밀번호는 환경 변수와 표준 입력으로만 넘긴다 (프로세스 인자에 드러나지 않게)
export MYSQL_PWD="$admin_password"
podman run --rm -i -e MYSQL_PWD "$MYSQL_IMAGE" \
  mysql -h "$host" -u "$admin_user" --ssl-mode=REQUIRED --default-character-set=utf8mb4 -N -B <<SQL
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
CREATE USER IF NOT EXISTS '$APP_USER'@'%' IDENTIFIED BY '$APP_DB_PASSWORD' REQUIRE SSL;
ALTER USER '$APP_USER'@'%' IDENTIFIED BY '$APP_DB_PASSWORD' REQUIRE SSL;
GRANT ALL PRIVILEGES ON \`$DB_NAME\`.* TO '$APP_USER'@'%';
SQL

echo "setup ok: database $DB_NAME, user $APP_USER (TLS required), host $host"
echo "app env: $APP_ENV (APP_DB_HOST, APP_DB_NAME, APP_DB_USER, APP_DB_PASSWORD)"
