#!/usr/bin/env bash
# 두 서버에서 상주한다. 로컬이 standby일 때만 상대 primary를 감시하고, 연속 실패 시 안전장치를 거쳐 승격한다.
#   1. 연속 실패 FAIL_THRESHOLD회 (INTERVAL초 간격)
#   2. 자기 고립 확인: 게이트웨이와 외부 모두 닿지 않으면 승격하지 않는다
#   3. 옛 primary 차단: SSH로 닿으면 PG를 멈추고 FENCED 표시. 멈추지 못하면 승격 중단.
#      SSH도 안 닿으면 FENCE_UNREACHABLE(abort|promote)에 따른다
#   4. 부팅 시 자동 primary 금지는 diary-pg-guard가 맡는다

source "$HOME/.local/bin/diary-pg-lib.sh"

fails=0
alerted=""

is_isolated() {
  local gw ext=fail gw_ok=fail
  gw="$(ip route | awk '/^default/ {print $3; exit}')"
  [[ -n "$gw" ]] && ping -c1 -W1 "$gw" >/dev/null 2>&1 && gw_ok=ok
  curl -s -o /dev/null --max-time 3 https://1.1.1.1/cdn-cgi/trace && ext=ok
  log_event isolation_check gateway="$gw_ok" external="$ext"
  [[ "$gw_ok" == fail && "$ext" == fail ]]
}

# 결과: fenced | stop_failed | unreachable
fence_peer() {
  local out rc
  out="$(timeout 60 ssh -o BatchMode=yes -o ConnectTimeout=5 diary-peer '
    systemctl --user stop diary-pg.service
    mkdir -p ~/.config/diary-pg && date -u +%FT%TZ > ~/.config/diary-pg/FENCED
    if podman ps --format "{{.Names}}" | grep -qx diary-pg; then echo still-running; else echo stopped; fi
  ' 2>&1)"
  rc=$?
  if [[ $rc -eq 255 || $rc -eq 124 ]]; then
    echo unreachable
  elif [[ "$out" == *stopped* ]]; then
    echo fenced
  else
    echo stop_failed
  fi
}

promote() {
  timeout 90 podman exec "$PG_CONTAINER" psql -U "$POSTGRES_USER" -d "$POSTGRES_DB" -Atc 'select pg_promote(true, 60)' 2>&1
}

try_failover() {
  local started_at=$SECONDS peer fence
  log_event failover_start fails="$fails" threshold="$FAIL_THRESHOLD"

  if is_isolated; then
    log_event failover_abort reason=self_isolated
    return
  fi

  peer="$(peer_role)"
  if [[ "$peer" != down ]]; then
    log_event failover_abort reason=peer_back peer_role="$peer"
    return
  fi

  fence="$(fence_peer)"
  log_event fence_result result="$fence"
  case "$fence" in
    fenced) ;;
    unreachable)
      if [[ "$FENCE_UNREACHABLE" != promote ]]; then
        log_event failover_abort reason=peer_unreachable_no_fence policy="$FENCE_UNREACHABLE"
        [[ -z "$alerted" ]] && slack "primary(${PEER_IP}) 응답 없음, SSH도 안 닿아 차단 불가 → 승격 중단(FENCE_UNREACHABLE=$FENCE_UNREACHABLE). 수동 확인 필요"
        alerted=1
        return
      fi
      ;;
    *)
      log_event failover_abort reason=fence_failed
      [[ -z "$alerted" ]] && slack "primary(${PEER_IP}) PG를 멈추지 못해 승격 중단. 수동 확인 필요"
      alerted=1
      return
      ;;
  esac

  local out
  out="$(promote)"
  if [[ "$(local_role)" == primary ]]; then
    log_event promoted fence="$fence" elapsed_s=$((SECONDS - started_at)) detect_s=$((fails * INTERVAL))
    slack "standby를 primary로 승격함 (옛 primary ${PEER_IP}: $fence, 감지 약 $((fails * INTERVAL))s + 승격 $((SECONDS - started_at))s). 옛 primary는 diary-pg-rejoin으로 standby 복귀 필요"
  else
    log_event promote_failed output="$out"
    slack "승격 실패: $out"
  fi
}

log_event watcher_start peer="$PEER_IP" interval="$INTERVAL" threshold="$FAIL_THRESHOLD" fence_unreachable="$FENCE_UNREACHABLE"

while true; do
  role="$(local_role)"

  if [[ "$role" == standby ]]; then
    peer="$(peer_role)"
    if [[ "$peer" == primary ]]; then
      if ((fails > 0)); then
        log_event peer_recovered fails="$fails"
      fi
      fails=0
      alerted=""
    elif [[ "$peer" == standby ]]; then
      # primary가 없는 상태. 차단 대상이 아니므로 알리기만 한다.
      [[ -z "$alerted" ]] && { log_event no_primary; slack "두 서버 모두 standby. 수동 확인 필요"; alerted=1; }
    else
      fails=$((fails + 1))
      log_event peer_check_failed fails="$fails" threshold="$FAIL_THRESHOLD"
      if ((fails >= FAIL_THRESHOLD)); then
        try_failover
        fails=0
      fi
    fi
  elif [[ "$role" == primary ]]; then
    if [[ "$(peer_role)" == primary ]]; then
      [[ -z "$alerted" ]] && { log_event split_brain peer="$PEER_IP"; slack "두 서버 모두 primary (split brain). 즉시 확인 필요"; alerted=1; }
    else
      alerted=""
    fi
  fi

  sleep "$INTERVAL"
done
