#!/usr/bin/env bash
# 옛 primary(또는 망가진 standby)를 현재 primary의 standby로 다시 만든다. 수동 실행용.
# 기존 볼륨은 지우기 전에 ~/pg-backups/에 내보낸다.

source "$HOME/.local/bin/diary-pg-lib.sh"
set -e

peer="$(peer_role)"
if [[ "$peer" != primary ]]; then
  echo "상대($PEER_IP)가 primary가 아니다: $peer" >&2
  exit 1
fi
if [[ "$(local_role)" == primary ]]; then
  echo "이 서버가 아직 primary다. split brain인지 먼저 확인할 것" >&2
  exit 1
fi

mkdir -p "$HOME/pg-backups"
systemctl --user stop diary-pg.service

if podman volume exists "$PG_VOLUME"; then
  backup="$HOME/pg-backups/pgdata-before-rejoin-$(date -u +%Y%m%dT%H%M%SZ).tar"
  podman volume export "$PG_VOLUME" -o "$backup"
  podman volume rm "$PG_VOLUME" >/dev/null
  log_event rejoin_volume_saved path="$backup"
fi

# 이전에 쓰던 같은 이름의 slot이 primary에 남아 있으면 지운다
podman run --rm --network host -e PGPASSWORD="$POSTGRES_PASSWORD" "$PG_IMAGE" \
  psql "host=$PEER_IP dbname=$POSTGRES_DB user=$POSTGRES_USER sslmode=require" -Atc \
  "select pg_drop_replication_slot(slot_name) from pg_replication_slots where slot_name = '$SLOT_NAME' and not active" >/dev/null

podman run --rm --network host -v "$PG_VOLUME:/var/lib/postgresql" -e PGPASSWORD="$REPL_PASSWORD" "$PG_IMAGE" bash -c "
  set -e
  mkdir -p $PGDATA_IN_CONTAINER
  chown postgres:postgres $PGDATA_IN_CONTAINER
  chmod 700 $PGDATA_IN_CONTAINER
  gosu postgres env PGPASSWORD=\"\$PGPASSWORD\" pg_basebackup \
    -d 'host=$PEER_IP port=5432 user=replicator sslmode=require application_name=$SLOT_NAME' \
    -D $PGDATA_IN_CONTAINER -R -X stream -C -S $SLOT_NAME -c fast
"

rm -f "$CONF_DIR/FENCED"
systemctl --user start diary-pg.service
log_event rejoined primary="$PEER_IP" slot="$SLOT_NAME"
slack "standby로 복귀함 (primary $PEER_IP, slot $SLOT_NAME)"
echo "rejoin 완료: $(local_role)"
