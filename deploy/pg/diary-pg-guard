#!/usr/bin/env bash
# diary-pg.service의 ExecStartPre. 부팅/재시작 때 옛 primary가 primary로 다시 뜨는 것을 막는다.
#   - standby 설정이면 그대로 기동
#   - primary 설정인데 (a) 이 호스트가 차단(FENCED)됐거나 (b) 상대가 이미 primary면 standby로 바꿔 기동
#     (타임라인이 갈라졌을 수 있으므로 diary-pg-rejoin으로 다시 맞춰야 한다. 그때까지는 읽기 전용이라 안전)
#   - 상대에 닿지 않으면 primary로 기동하고 기록만 남긴다

source "$HOME/.local/bin/diary-pg-lib.sh"

if ! podman volume exists "$PG_VOLUME"; then
  log_event guard_skip reason=no_volume
  exit 0
fi

D="$(pgdata_host_path)"

if ! podman unshare test -f "$D/PG_VERSION"; then
  log_event guard_skip reason=empty_pgdata
  exit 0
fi

if podman unshare test -f "$D/standby.signal"; then
  log_event guard_start role=standby
  exit 0
fi

reason=""
if [[ -f "$CONF_DIR/FENCED" ]]; then
  reason="fenced"
else
  peer="$(peer_role)"
  [[ "$peer" == primary ]] && reason="peer_is_primary"
fi

if [[ -z "$reason" ]]; then
  log_event guard_start role=primary peer="${peer:-unknown}"
  exit 0
fi

podman unshare sh -c "
  set -e
  touch '$D/standby.signal'
  cat >>'$D/postgresql.auto.conf' <<CONF
# diary-pg-guard $(date -u +%FT%TZ): $reason
primary_conninfo = 'host=$PEER_IP port=5432 user=replicator password=$REPL_PASSWORD sslmode=require application_name=$SLOT_NAME'
primary_slot_name = ''
CONF
  chown 999:999 '$D/standby.signal' '$D/postgresql.auto.conf'
"

log_event guard_demoted reason="$reason"
slack "옛 primary를 standby로 기동함 (reason=$reason). 복제를 다시 맞추려면 이 서버에서 diary-pg-rejoin 실행 필요"
exit 0
