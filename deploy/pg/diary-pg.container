[Unit]
Description=PostgreSQL 18 for diary
After=network-online.target
Wants=network-online.target

[Container]
ContainerName=diary-pg
Image=docker.io/library/postgres:18.6
Network=host
Volume=diary-pgdata:/var/lib/postgresql
Volume=%h/.config/diary-pg:/etc/diary-pg:ro,Z
EnvironmentFile=%h/.config/diary-pg.env
PodmanArgs=--memory=256m --memory-swap=512m --shm-size=128m
Exec=postgres \
  -c listen_addresses=* -c port=5432 \
  -c hba_file=/etc/diary-pg/pg_hba.conf \
  -c ssl=on -c ssl_cert_file=/etc/diary-pg/server.crt -c ssl_key_file=/etc/diary-pg/server.key \
  -c max_connections=30 -c shared_buffers=64MB -c effective_cache_size=256MB \
  -c work_mem=2MB -c maintenance_work_mem=32MB -c autovacuum_max_workers=2 -c jit=off \
  -c wal_level=replica -c wal_log_hints=on -c max_wal_senders=4 -c max_replication_slots=4 \
  -c wal_keep_size=256MB -c max_slot_wal_keep_size=1GB -c max_wal_size=256MB -c min_wal_size=64MB \
  -c hot_standby=on -c hot_standby_feedback=on -c password_encryption=scram-sha-256 \
  -c log_connections=on -c log_disconnections=on -c log_line_prefix=%%m|%%p|%%h|%%u@%%d|

[Service]
# 옛 primary가 primary로 다시 뜨지 않게 막는다
ExecStartPre=%h/.local/bin/diary-pg-guard
Restart=always
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=90

[Install]
WantedBy=default.target
