#!/usr/bin/env bash
# diary-deploy.timer가 1분마다 root로 부른다 (cheotmadi-api의 pull-deploy와 같은 방식).
#
# GitHub의 deploy 가지(CI가 시험을 통과한 main 커밋으로 옮겨 둔다)가 움직였으면:
#   1. 권한 없는 사용자(diary-build)로 빌드하고, 최종 경로에서 AOT 캐시를 훈련한다
#   2. current 링크를 바꾸고 `systemctl restart diary`. 앱이 DB까지 붙어 200을 줄 때까지 systemd가 기다린다
#   3. 실패하면 이전 릴리스로 되돌린다
# 컴퓨터가 하나라서 재시작 동안(측정으로 약 4초) 앱이 응답하지 못한다. Cloudflare 엣지 캐시에 있는 GET은 그동안에도 나간다.
#
# 서버가 가져가는 방식이라 GitHub에는 서버에 들어갈 비밀이 없다. 서버는 이 저장소만 읽는 deploy key를 갖는다.
set -Eeuo pipefail

readonly APP_DIR=/opt/diary
readonly STATE_DIR=/var/lib/diary-deploy
readonly BUILD_HOME=/var/lib/diary-build
readonly SRC="$BUILD_HOME/src"
readonly KEEP_RELEASES=3

readonly DEPLOY_BRANCH=deploy

mkdir -p "$STATE_DIR"
# 한 번에 하나만 돈다 (빌드가 1분보다 길 수 있다)
exec 9>"$STATE_DIR/lock"
flock -n 9 || exit 0

log() { echo "diary-pull-deploy: $*"; }

# 같은 이유로 멈춘 상태를 1분마다 반복해서 찍지 않는다
block() {
  if [[ "$(cat "$STATE_DIR/blocked" 2>/dev/null || true)" != "$1" ]]; then
    log "$1" >&2
    echo "$1" >"$STATE_DIR/blocked"
  fi
  exit 0
}

# 설치된 헬퍼 스크립트가 저장소 것과 다르면 알린다 (자동으로 바꾸지 않는다. setup-server.sh를 다시 돌린다)
warn_stale_scripts() {
  local f
  for f in diary-pull-deploy diary-run diary-jvm.conf diary-wait-healthy diary-env diary-db-check; do
    if [[ -f "$SRC/deploy/hoody/$f" && -f "$APP_DIR/bin/$f" ]] && ! cmp -s "$SRC/deploy/hoody/$f" "$APP_DIR/bin/$f"; then
      log "경고: 설치된 $f 가 저장소와 다르다. deploy/hoody/setup-server.sh를 다시 실행한다" >&2
    fi
  done
}

# git은 권한 없는 사용자로 돌린다. 읽기 전용 deploy key만 쓴다.
as_build() {
  runuser -u diary-build -- env \
    HOME="$BUILD_HOME" \
    GIT_SSH_COMMAND="ssh -i $BUILD_HOME/.ssh/deploy -o IdentitiesOnly=yes -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$BUILD_HOME/.ssh/known_hosts" \
    "$@"
}

as_build git -C "$SRC" fetch -q origin "$DEPLOY_BRANCH"
want="$(as_build git -C "$SRC" rev-parse FETCH_HEAD)"

# 실패한 커밋을 1분마다 다시 시도하지 않도록, 성공과 상관없이 마지막으로 시도한 커밋을 적어 둔다
# (고친 커밋이 deploy 가지로 오면 다른 해시라서 다시 시도한다. 같은 커밋을 다시 올리려면 이 파일을 지운다)
if [[ "$want" == "$(cat "$STATE_DIR/last-commit" 2>/dev/null || true)" ]]; then
  exit 0
fi

# 비밀 값을 채우지 않았으면 올리지 않는다 (채운 뒤에 다시 시도하도록 last-commit은 적지 않는다)
if grep -q 'CHANGE_ME' /etc/diary/diary.env; then
  block "/etc/diary/diary.env에 CHANGE_ME가 남아 있어 배포하지 않는다"
fi
: >"$STATE_DIR/blocked"

echo "$want" >"$STATE_DIR/last-commit"
release="$APP_DIR/releases/${want:0:12}"
previous=""
[[ -e "$APP_DIR/current" ]] && previous="$(readlink -f "$APP_DIR/current")"
log "시작: ${want:0:12} (이전: ${previous:-없음})"

if [[ "$release" == "$previous" ]]; then
  log "이미 이 릴리스를 쓰고 있다"
  exit 0
fi

# JDK와 Gradle 설정. 빌드는 메모리를 작게 쓴다: 데몬을 쓰지 않고 Kotlin 컴파일러도 같은 프로세스에서 돌린다
java_home="$(dirname "$(dirname "$(readlink -f /usr/bin/java)")")"
rm -rf "$release"
install -d -o diary-build -g diary-build -m 755 "$release"

as_build bash -c '
  set -Eeuo pipefail
  cd "$1"
  git checkout -q --detach "$2"
  export JAVA_HOME="$3" GRADLE_USER_HOME="$4/.gradle"
  ./gradlew --no-daemon --console=plain -q bootJar -x test \
    -Dorg.gradle.jvmargs="-Xmx1g -XX:+UseSerialGC" \
    -Pkotlin.compiler.execution.strategy=in-process \
    -PappVersion="${2:0:12}"
' _ "$SRC" "$want" "$java_home" "$BUILD_HOME"

# 중첩 jar가 아닌 풀어 쓴 형태여야 AOT 캐시가 클래스를 찾는다
as_build /usr/bin/java -Djarmode=tools -jar "$SRC/build/libs/diary.jar" extract --destination "$release/app"

# AOT 캐시 훈련: DB 없이 컨텍스트만 한 번 띄워 클래스 로딩 결과를 담는다 (application-training.yaml).
# 캐시는 이 최종 경로와 이 JDK에 묶이므로 서버에서 만든다. 실패해도 캐시 없이 뜨므로 배포는 계속한다.
# shellcheck source=/dev/null
source "$APP_DIR/bin/diary-jvm.conf"
if as_build /usr/bin/java "${JVM_FLAGS[@]}" \
  -XX:AOTCacheOutput="$release/app/diary.aot" \
  -Dspring.context.exit=onRefresh -Dspring.profiles.active=training \
  -jar "$release/app/diary.jar" >"$STATE_DIR/aot-training.log" 2>&1; then
  log "AOT 캐시 생성: $(stat -c %s "$release/app/diary.aot") bytes"
else
  log "AOT 캐시 훈련 실패. 캐시 없이 올린다 (로그: $STATE_DIR/aot-training.log)" >&2
  rm -f "$release/app/diary.aot"
fi

# 실행 파일은 root 소유, 쓰기 불가로 잠근다 (mtime은 그대로라 AOT 캐시 검증을 통과한다)
chown -R root:root "$release"
chmod -R u=rwX,go=rX "$release"

switch_to() {
  ln -sfn "$1" "$APP_DIR/current.new"
  mv -T "$APP_DIR/current.new" "$APP_DIR/current"
}

rollback() {
  log "새 릴리스가 건강하지 않다. 이전 릴리스로 되돌린다: ${previous:-없음}" >&2
  if [[ -n "$previous" && -d "$previous" ]]; then
    switch_to "$previous"
    systemctl restart diary || log "되돌린 릴리스도 시작하지 못했다. 직접 확인한다: journalctl -u diary" >&2
  fi
  exit 1
}

[[ -n "$previous" ]] && ln -sfn "$previous" "$APP_DIR/previous"
switch_to "$release"
# 앱이 DB까지 붙어 200을 줄 때까지 systemctl이 기다렸다가 돌아온다 (diary.service의 ExecStartPost)
if ! systemctl restart diary; then
  rollback
fi
if ! systemctl is-active --quiet diary; then
  rollback
fi
log "배포했다: ${want:0:12}"

# 오래된 릴리스를 지운다 (현재, 이전, 최신 몇 개는 남긴다)
keep_current="$(readlink -f "$APP_DIR/current")"
keep_previous="$(readlink -f "$APP_DIR/previous" 2>/dev/null || true)"
while read -r dir; do
  [[ "$dir" == "$keep_current" || "$dir" == "$keep_previous" ]] && continue
  rm -rf "$dir"
done < <(ls -1dt "$APP_DIR"/releases/*/ 2>/dev/null | sed 's:/$::' | tail -n +$((KEEP_RELEASES + 1)))
