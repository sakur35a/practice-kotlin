#!/usr/bin/env bash
# 이 컴퓨터의 기존 cloudflared 설정(/etc/cloudflared/config.yml)에 diary API용 인그레스 한 줄을 안전하게 더한다.
# 이 설정은 다른 앱(cheotmadi-api)의 터널이 쓰는 파일이다. 그래서 기본은 아무것도 바꾸지 않고 결과만 보여 준다.
#
#   diary-ingress                       미리 보기
#   diary-ingress --apply               백업 → 쓰기 → cloudflared로 검증 (틀리면 되돌림)
#   diary-ingress --apply --restart     적용한 뒤 cloudflared 서비스 재시작 (설정은 시작 때만 읽는다. 다른 앱 터널이 몇 초 끊긴다)
#   옵션: --hostname api.ssobbs13.pp.ua  --service http://localhost:18080  --config /etc/cloudflared/config.yml
#
# 더하는 내용 (맨 마지막의 `service: http_status:404` 바로 앞에):
#     - hostname: api.ssobbs13.pp.ua
#       service: http://localhost:18080
# 이 규칙은 DNS가 이 터널을 가리키기 전에는 아무 트래픽도 받지 않으므로 컷오버 며칠 전에 미리 적용해 두어도 안전하다.
set -Eeuo pipefail

hostname=api.ssobbs13.pp.ua
service=http://localhost:18080
config=/etc/cloudflared/config.yml
apply=0
restart=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --hostname) hostname="${2:?}"; shift 2 ;;
    --service) service="${2:?}"; shift 2 ;;
    --config) config="${2:?}"; shift 2 ;;
    --apply) apply=1; shift ;;
    --restart) restart=1; shift ;;
    *) echo "알 수 없는 인자: $1" >&2; exit 2 ;;
  esac
done
[[ "$hostname" =~ ^[a-z0-9.-]+$ && "$service" =~ ^[a-z]+://[A-Za-z0-9.:_-]+$ ]] || { echo "호스트 이름이나 서비스 형식이 이상하다" >&2; exit 2; }
[[ -r "$config" ]] || { echo "설정 파일을 읽을 수 없다: $config" >&2; exit 1; }

if grep -Eq "^[[:space:]]*-[[:space:]]*hostname:[[:space:]]*['\"]?${hostname}['\"]?[[:space:]]*$" "$config"; then
  echo "이미 $hostname 인그레스가 있다. 바꿀 것이 없다"
  exit 0
fi

catchall_count="$(grep -Ec '^[[:space:]]*-[[:space:]]*service:[[:space:]]*http_status:[0-9]+[[:space:]]*$' "$config" || true)"
if [[ "$catchall_count" != 1 ]]; then
  echo "맨 끝 catch-all(- service: http_status:404) 줄을 하나로 찾지 못했다($catchall_count개). 직접 고친다" >&2
  exit 1
fi

new="$(mktemp)"
trap 'rm -f "$new"' EXIT
HOSTNAME_NEW="$hostname" SERVICE_NEW="$service" awk '
  /^[[:space:]]*-[[:space:]]*service:[[:space:]]*http_status:[0-9]+[[:space:]]*$/ {
    match($0, /^[[:space:]]*/); indent = substr($0, 1, RLENGTH)
    print indent "- hostname: " ENVIRON["HOSTNAME_NEW"]
    print indent "  service: " ENVIRON["SERVICE_NEW"]
  }
  { print }
' "$config" >"$new"

diff -u "$config" "$new" || true
if ((apply == 0)); then
  echo "(미리 보기만 했다. 적용하려면 --apply)"
  exit 0
fi

backup="$config.bak-$(date -u +%Y%m%dT%H%M%SZ)"
cp -p "$config" "$backup"
cat "$new" >"$config" # 같은 파일(inode)에 덮어써서 소유자와 권한을 유지한다
if command -v cloudflared >/dev/null && ! cloudflared tunnel --config "$config" ingress validate; then
  echo "검증 실패. 되돌린다: $backup" >&2
  cat "$backup" >"$config"
  exit 1
fi
echo "적용했다. 백업: $backup"
if ((restart)); then
  systemctl restart cloudflared
  echo "cloudflared 재시작함"
else
  echo "반영하려면 cloudflared를 재시작한다: systemctl restart cloudflared  (설정은 시작 때만 읽는다)"
fi
